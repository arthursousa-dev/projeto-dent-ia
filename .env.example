# Copie para .env e preencha. O .env não deve ir para o Git.
# PostgreSQL local (serviço postgresql-x64-18, porta 5432)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dentia
DB_USER=postgres
DB_PASS=
# Endereço e porta do servidor PHP. 0.0.0.0 = acessível na rede local; 127.0.0.1 = só neste computador.
APP_HOST=0.0.0.0
APP_PORT=8000
# true mostra detalhes de erros SQL na tela; use só para depurar.
APP_DEBUG=false
# true mostra o quadro "Credenciais de demonstração" nas telas de login. Deixe false em produção.
APP_DEMO=false
# true só quando o PHP roda atrás de um proxy confiável (Railway, nginx): o limite de tentativas usa o IP do X-Forwarded-For.
APP_PROXY_CONFIAVEL=false
# true libera a tela "Banco de dados" (dono_banco.php) para o gestor em outros aparelhos da rede. Padrão: só neste computador.
APP_MONITOR_REDE=false
