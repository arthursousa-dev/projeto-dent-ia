# Copie para .env e preencha. O .env não deve ir para o Git.
# PostgreSQL local (serviço postgresql-x64-18, porta 5432)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dentia
# Instalação nova: comece com DB_USER=postgres para criar o banco (instalar_banco.bat) e aplicar as migrações;
# depois rode php scripts/configurar_papeis.php, que troca estas linhas para o papel sem privilégios dentia_app.
DB_USER=postgres
DB_PASS=
# Dono das tabelas, para migrações, limpeza e backup. Preenchido por scripts/configurar_papeis.php.
#DB_MIGRACAO_USER=dentia_migracao
#DB_MIGRACAO_PASS=
# Endereço e porta do servidor PHP. 127.0.0.1 = só neste computador (padrão). 0.0.0.0 = rede local: só com HTTPS na frente.
APP_HOST=127.0.0.1
APP_PORT=8000
# true mostra detalhes de erros SQL na tela; use só para depurar.
APP_DEBUG=false
# true mostra o quadro "Credenciais de demonstração" nas telas de login. Deixe false em produção.
APP_DEMO=false
# true quando o PHP roda atrás de um proxy confiável (o Caddy do iniciar_dentia.bat, Railway, nginx): o cookie de sessão
# só trafega em HTTPS e o limite de tentativas usa o endereço do visitante informado pelo proxy. Sem proxy: false.
APP_PROXY_CONFIAVEL=true
# true libera a tela "Banco de dados" (dono_banco.php) para o gestor em outros aparelhos da rede. Padrão: só neste computador.
APP_MONITOR_REDE=false
