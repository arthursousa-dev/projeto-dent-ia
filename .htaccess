Options -Indexes
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule ^(database|scripts|tests|docs|includes|app|dados|vendor|deploy)(/|$) - [F,L,NC]
RewriteRule (^|/)\.(?!well-known/) - [F,L]
</IfModule>
<FilesMatch "^(\.env|composer\.(json|lock)|phpunit\.xml|Dockerfile|README\.md)$">
    Require all denied
</FilesMatch>
# .htaccess — cabeçalhos de segurança e bloqueio de arquivos sensíveis

Options -Indexes

<FilesMatch "(^\.env|\.sql|\.log|composer\.(json|lock))$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Bloqueia acesso direto às pastas de código/dados que não devem
# ser servidas como páginas.
RewriteEngine On
RewriteRule ^(app|database|includes)/ - [F,L]

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
